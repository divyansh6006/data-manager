# ============================================================================
# Skill Labs Data Manager - Environment Configurations Template
# ============================================================================

# Application Environment (development / production)
NODE_ENV=production

# Server Port
PORT=5000

# Security - JWT Private Key for Token Signature
JWT_SECRET=change_me_to_a_long_random_string

# Comma-separated list of origins allowed to call this API (your deployed frontend URL(s))
CORS_ORIGIN=https://crm.yourdomain.com

# Database Configurations (Only required if NODE_ENV=production)
# Option A: Single Connection URI string (Preferred by Heroku/Render/etc.)
DATABASE_URL=postgresql://<db-user>:<db-password>@<db-host>:5432/<db-name>

# Option B: Individual Connection Parameter fields
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=<db-user>
DB_PASSWORD=<db-password>
DB_NAME=crm_lead

# Set to 'true' to require TLS/SSL for the Postgres connection (recommended in production)
DB_SSL=false
